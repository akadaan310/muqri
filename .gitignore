# Large generated artifacts — regenerable, never committed
# muaalem posterior dumps: raw float32 per clip (modal_T300 alone is 1.8 GB)
research_agency_lab/experiments/qaari_keys/dump_*/
research_agency_lab/experiments/qaari_keys/modal_*/
# ONNX exports of the 605 M-param acoustic model (2.9 GB)
research_agency_lab/experiments/sdk/
*.onnx
*.onnx.data
*.f32
# per-shard benchmark rows from cloud runs (514 MB)
benchmarks/results/modal/

# recording-protocol takes: a person's voice, never committed
research_agency_lab/experiments/protocol_recordings/
# calculus-of-characteristics unit arrays (regenerable, ~100 MB)
research_agency_lab/experiments/calculus/data/
# the recitation graph database and its CSVs (regenerable: datastore.recitation_graph build)
research_agency_lab/experiments/calculus/graph/

# stray DuckDB session artifacts
*.ses
# per-verse engine records: regenerable on Modal in ~5 min; the final set is kept as clips.jsonl.gz
research_agency_lab/experiments/profiles/*.jsonl
# learner histories: personal, never committed
research_agency_lab/experiments/learners/

# external-dataset engine outputs: regenerable from the Modal dumps (modal_external.py::grade)
research_agency_lab/experiments/external/*_engine.jsonl
