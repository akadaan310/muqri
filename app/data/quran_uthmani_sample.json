{
 "1": {
  "name": "Al-Faatiha",
  "ayahs": {
   "1": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ",
   "2": "ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ",
   "3": "ٱلرَّحْمَٰنِ ٱلرَّحِيمِ",
   "4": "مَٰلِكِ يَوْمِ ٱلدِّينِ",
   "5": "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ",
   "6": "ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ",
   "7": "صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ"
  }
 },
 "103": {
  "name": "Al-Asr",
  "ayahs": {
   "1": "وَٱلْعَصْرِ",
   "2": "إِنَّ ٱلْإِنسَٰنَ لَفِى خُسْرٍ",
   "3": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ وَتَوَاصَوْا۟ بِٱلْحَقِّ وَتَوَاصَوْا۟ بِٱلصَّبْرِ"
  }
 },
 "108": {
  "name": "Al-Kawthar",
  "ayahs": {
   "1": "إِنَّآ أَعْطَيْنَٰكَ ٱلْكَوْثَرَ",
   "2": "فَصَلِّ لِرَبِّكَ وَٱنْحَرْ",
   "3": "إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ"
  }
 },
 "112": {
  "name": "Al-Ikhlaas",
  "ayahs": {
   "1": "قُلْ هُوَ ٱللَّهُ أَحَدٌ",
   "2": "ٱللَّهُ ٱلصَّمَدُ",
   "3": "لَمْ يَلِدْ وَلَمْ يُولَدْ",
   "4": "وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ"
  }
 },
 "113": {
  "name": "Al-Falaq",
  "ayahs": {
   "1": "قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ",
   "2": "مِن شَرِّ مَا خَلَقَ",
   "3": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ",
   "4": "وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ",
   "5": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ"
  }
 },
 "114": {
  "name": "An-Naas",
  "ayahs": {
   "1": "قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ",
   "2": "مَلِكِ ٱلنَّاسِ",
   "3": "إِلَٰهِ ٱلنَّاسِ",
   "4": "مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ",
   "5": "ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ",
   "6": "مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ"
  }
 }
}