  "high_positional_lift": {
    "rule": "coefficient digit d at decimal place p; p>=3 uses p modulo 3; p%3=0 -> Ghayn if d=1 else d-th units glyph; p%3=1 -> d-th tens glyph; p%3=2 -> d-th hundreds glyph",
    "positional_value": "d*10^p; never replace numeric weight with the reused glyph's native value",
    "low_alif_prohibition": "for all p>=3, coefficient 1 at a 3k position is Ghayn, not Alif; lower p=0 coefficient 1 remains Alif",
    "sifr": "digit 0 has an explicit typed gap cell; never infer original places from an untagged glyph string",
    "return_period": 3,
    "cell_required_fields": [
      "position",
      "coefficient",
      "kind",
      "glyph"
    ],
    "glyph_only_inversion": "noninjective; position tags or canonical decimal value required"
  },
  "state_types": {
    "sifr": [
      "gap",
      "numeric_zero",
      "unbound_operand",
      "pending_operator",
      "reserved_argument"
    ],
    "control": [
      "ALIF-LIFF",
      "GHAYN-RETURN",
      "QITT-BOUNDARY",
      "CARRY",
      "BORROW",
      "FLIP",
      "BIND",
      "RELEASE"
    ],
    "word_profiles": [
      "bare_graphemes",
      "diacritics_preserved",
      "shadda_expanded_opt_in"
    ],
    "epistemic": [
      "owner_axiom",
      "defined_here",
      "derived",
      "open"
    ]
  },
  "operator_contracts": {
    "LIFF": {
      "input": "canonical finite decimal digit tape",
      "guard": "selected digit==9 for a carry step",
      "effect": "set the digit to 0 and carry 1 into next position; if needed create a new leading place; numeric value increments by 1 over the whole tape",
      "not": "not a statement about historical Arabic letter etymology"
    },
    "GHAYN_RETURN": {
      "input": "position p >=3 and p mod 3==0 with coefficient 1",
      "effect": "output Ghayn glyph with position tag; keep p and cycle identity"
    },
    "FLIP": {
      "input": "control bit in {0,1}",
      "effect": "toggle bit; do not equate XOR with decimal carry"
    },
    "QITT_BOUNDARY": {
      "input": "profiled Arabic word ق ط or frame QAF:[SIFR]:TTA",
      "effect": "recognize hundred-start + absent-ten + unit-terminal with numeric 109 in grapheme-additive profile",
      "not": "not a default arithmetic halting operation for arbitrary lexemes"
    }
  },
  "bit_motif": {
    "initial": "0000",
    "states": [
      "0000",
      "1000",
      "1100",
      "1110",
      "1000"
    ],
    "meaning": "separate finite control path; leading bit retained by RETURN; not binary increment",
    "terminal": "RETURN_TO_ONE",
    "cycles_from": "1000"
  },
